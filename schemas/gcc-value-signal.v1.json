{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://highvaluecapitalgroup.com/contracts/gcc-value-signal.v1.json",
  "title": "GCC Value Signal v1",
  "description": "Canonical Platform Integration SoT. GCC client-value intelligence signal back to Atlas for renewal/expansion review. Not a CRM write of GCC ledgers. Local gcc-atlas-signal.v1 is an adapter source only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "signalId",
    "clientCode",
    "signalType",
    "emittedAt",
    "envelope"
  ],
  "properties": {
    "contractVersion": { "const": "gcc-value-signal.v1" },
    "signalId": { "type": "string", "minLength": 1, "maxLength": 255 },
    "clientCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{2,15}$" },
    "gccOrganizationId": { "type": "string", "minLength": 1, "maxLength": 255 },
    "signalType": {
      "type": "string",
      "enum": [
        "renewal_risk",
        "expansion_opportunity",
        "value_realized",
        "engagement_health",
        "ltv_update"
      ]
    },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "summary": { "type": "string", "maxLength": 2000 },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": ["number", "string", "boolean", "null"] }
    },
    "emittedAt": { "type": "string", "format": "date-time" },
    "copiesLedger": { "const": false },
    "envelope": { "type": "object" }
  }
}
