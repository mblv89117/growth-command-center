# Auth / data plane (dual-mode)
# Default production today: Supabase. Microsoft-native cutover: AUTH_PROVIDER=entra + AZURE_DATABASE_URL.
# AUTH_PROVIDER=supabase
# NEXT_PUBLIC_AUTH_PROVIDER=supabase
# AZURE_DATABASE_URL=postgresql://user:pass@host:5432/gcc?sslmode=require
# ENTRA_EXTERNAL_TENANT_ID=
# ENTRA_EXTERNAL_CLIENT_ID=
# ENTRA_EXTERNAL_CLIENT_SECRET=
# ENTRA_EXTERNAL_AUTHORITY=
# ENTRA_EXTERNAL_REDIRECT_URI=https://app.growthcommandcenter.com/auth/callback
# SESSION_SECRET=use-a-32+-char-random-string

# Supabase (required while AUTH_PROVIDER=supabase; optional rollback after Entra cutover)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (required in production)
NEXT_PUBLIC_APP_URL=https://app.growthcommandcenter.com

# Marketing URL (required in production)
NEXT_PUBLIC_MARKETING_URL=https://growthcommandcenter.com

# QuickBooks Online
QUICKBOOKS_CLIENT_ID=your-client-id
QUICKBOOKS_CLIENT_SECRET=your-client-secret
QUICKBOOKS_REDIRECT_URI=https://your-domain.com/api/integrations/quickbooks/callback
QUICKBOOKS_ENV=sandbox

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_GROWTH_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# Plaid (bank connections)
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox

# Anthropic (AI Advisor — server-side only)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Production only — set to "true" to allow demo mode (not recommended)
# ALLOW_DEMO_MODE=false

# Local SMTP setup only (use .env.smtp.local — gitignored, never commit)
# SUPABASE_ACCESS_TOKEN=your-supabase-management-api-token
# RESEND_API_KEY=re_...
